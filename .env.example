# FantasyPros account email — this alone enumerates every league + per-league key
FP_EMAIL=your-fantasypros-email@example.com

# Optional: extra league keys not tied to the email above (comma separated)
# FP_EXTRA_KEYS=nfl~xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# FantasyPros public API v2 key — request at https://secure.fantasypros.com/api-keys/request/
# This is a DIFFERENT credential from the MyPlaybook league keys above.
FP_API_KEY=your-fp-api-key

# Optional: pin season/week. Both are auto-detected from the calendar when unset.
# FP_SEASON=2026
# FP_WEEK=1

# Optional: FantasyPros website session cookie — the FULL `Cookie:` header
# value from a logged-in fantasypros.com request (DevTools > Network > any
# request to that host > Request Headers > Cookie). Unlocks the full
# projections board; logged out, only the top ~10 players/position are
# public (a registration fence hides the rest). Rankings need no cookie.
# FP_COOKIE=

# Optional tuning
FP_CONCURRENCY=3
FP_DELAY_MS=250


# Per-request deadline in ms. 0 disables it. Default 30000.
FP_TIMEOUT_MS=30000

# Minimum gap in ms between FantasyPros API v2 calls (burst rate limit).
# Default 1200. Raise it if you see 429s on fp:sync.
FP_API_GAP_MS=1200

# Optional: a private ESPN league's cookies (espn_s2 and SWID from a logged-in
# fantasy.espn.com request). Sent ONLY to Dynasty Daddy's league/load, so it can
# refresh the league; without them it serves whatever it cached last.
# ESPN_S2=
# ESPN_SWID=

# VegasEdgeFantasy session cookie — the `access_token` cookie value from a
# logged-in vegasedgefantasy.com browser session (DevTools > Application >
# Cookies). It is a JWT and expires about every 30 days; `vegas:sync` says so.
# VEGAS_TOKEN=
